# TMDB: folosește cheia v3 sau tokenul Read Access v4.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Supabase: cheia service role rămâne exclusiv pe server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider video autorizat. Nu include slash la final.
NEXT_PUBLIC_STREAM_BASE_URL=

# iframe (implicit) sau hls, dacă endpoint-ul întoarce direct un manifest .m3u8.
NEXT_PUBLIC_STREAM_MODE=iframe
