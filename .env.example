# TMDB: use the v3 API key or the v4 Read Access token.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Required for accounts and per-user watch history. Use a publishable key
# (or the legacy anon key), never a secret/service-role key in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional override for the Vidstuck embed host.
# Defaults to https://vidstuck.cc/embed.
NEXT_PUBLIC_STREAM_BASE_URL=
